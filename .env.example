# Contoh konfigurasi environment frontend SmartSkin.
# Vite hanya membaca variabel berawalan VITE_.
#
# Tidak perlu diedit untuk pemakaian normal — sudah diatur lewat:
#   - .env.development  -> backend local  (npm run dev)
#   - .env.production   -> backend deploy (npm run build / npm run dev:deploy)
#
# Buat .env.local kalau mau override sementara di mesin sendiri
# (.env.local menimpa semua, dan tidak ikut ter-commit).

VITE_API_BASE_URL=http://localhost:3000
